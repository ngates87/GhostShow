<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:browser="using:GhostShow.Browser"
             xmlns:vm="using:GhostShow.App.ViewModels"
             xmlns:views="using:GhostShow.App.Views"
             xmlns:controls="using:GhostShow.App.Controls"
             x:Class="GhostShow.Browser.BrowserApp"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://ghostshow-app/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ghostshow-app/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- A device's parts of the shared main view (ShellViewModel's places; the show computer fills them its own way). -->
  <Application.DataTemplates>
    <DataTemplate DataType="browser:BrowserStatusViewModel">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding SaveState}" Opacity="0.7" IsVisible="{Binding ShowsSaveState}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Who}" Opacity="0.7" VerticalAlignment="Center" />
        <ContentControl Content="{Binding Load}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <!-- The show computer's load meter, as on its own screen (App.axaml); click for Diagnostics -->
    <DataTemplate DataType="vm:PerformanceMeterViewModel">
      <Button Padding="4,1" MinHeight="0" Background="Transparent" BorderThickness="0"
              Command="{Binding $parent[views:MainView].((vm:ShellViewModel)DataContext).GoToCommand}" CommandParameter="{x:Static vm:Page.Diagnostics}"
              ToolTip.Tip="{Binding Tip}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="LOAD" FontSize="10" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
          <controls:LoadMeter Value="{Binding Level}" Width="120" Height="14" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate DataType="vm:ButtonsViewModel">
      <views:ButtonsPanel />
    </DataTemplate>
    <DataTemplate DataType="vm:InputsViewModel">
      <views:InputsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AudioViewModel">
      <views:AudioView />
    </DataTemplate>
    <DataTemplate DataType="vm:DiagnosticsViewModel">
      <views:DiagnosticsView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
