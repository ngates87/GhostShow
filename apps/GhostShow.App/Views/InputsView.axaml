<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             xmlns:views="using:GhostShow.App.Views"
             xmlns:inputs="using:GhostShow.Core.Inputs"
             x:Class="GhostShow.App.Views.InputsView"
             x:DataType="vm:InputsViewModel">
  <!-- Inputs: the show's input devices (left), what this computer has to add (right), and the input monitor (below).
       Laid out like the DMX outputs: the show stores names and settings, the computer which port each is on. -->
  <Grid RowDefinitions="Auto,*" Margin="0,12">
    <Grid ColumnDefinitions="1.5*,16,*">
      <StackPanel Spacing="6">
        <TextBlock Text="Show's inputs" Classes="heading" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="What the show listens to. A button's trigger names the input, and what to listen for on it. Names and speeds belong to the show; the port each is on belongs to this computer, so a show opened elsewhere keeps its triggers and only needs its ports picked." />
        <ScrollViewer MaxHeight="440">
          <StackPanel Spacing="8">
            <Border Classes="card">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Content="Monitor" VerticalAlignment="Top" Command="{Binding MonitorKeyboardCommand}"
                              IsChecked="{Binding IsKeyboardMonitored, Mode=OneWay}" ToolTip.Tip="Show only the keyboard's inputs in the monitor below" />
                <StackPanel Spacing="2">
                  <TextBlock Text="Keyboard" FontWeight="SemiBold" />
                  <TextBlock Opacity="0.7" TextWrapping="Wrap"
                             Text="Always on. F keys always press their buttons; letters and digits do unless a field has the cursor." />
                </StackPanel>
              </DockPanel>
            </Border>
            <ItemsControl x:Name="InputDevices" ItemsSource="{Binding Devices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InputDeviceRowViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto">
                        <TextBox Text="{Binding Name}" ToolTip.Tip="What the show calls it, e.g. the device or the room it's in" />
                        <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Opacity="0.7" VerticalAlignment="Center" />
                        <ToggleButton Grid.Column="4" Content="Monitor" Command="{Binding MonitorCommand}" IsChecked="{Binding IsMonitored, Mode=OneWay}"
                                      ToolTip.Tip="Show only this input's commands in the monitor below" />
                        <Button Grid.Column="6" Content="Remove"
                                Command="{Binding $parent[ItemsControl].((vm:InputsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Remove it from the show. Buttons listening to it keep their triggers (Undo puts it back)." />
                      </Grid>
                      <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsSerial}">
                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="InputPort" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="200" Margin="0,0,20,4"
                                  ToolTip.Tip="The port it's plugged into on this computer (this computer's setting)" />
                        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{x:Static inputs:SerialInputDevice.BaudRates}" SelectedItem="{Binding BaudRate}" MinWidth="110" Margin="0,0,0,4"
                                  ToolTip.Tip="The device's manual gives it; 9600 is the most common. Always 8 data bits, no parity, 1 stop bit." />
                        <TextBlock Text="baud" VerticalAlignment="Center" Margin="6,0,20,0" />
                        <CheckBox Content="Listen" IsChecked="{Binding IsEnabled}" IsVisible="{Binding HasPort}"
                                  ToolTip.Tip="Off keeps the port picked but closed, e.g. to let another program use it." />
                      </WrapPanel>
                      <TextBlock x:Name="InputStatus" Text="{Binding StatusLabel}" TextWrapping="Wrap" Classes.fault="{Binding IsFaulted}" />
                      <TextBlock Text="{Binding LastReceived}" Opacity="0.7" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No inputs yet: add the port a sensor box or prop controller is plugged into, from the list on the right."
                       TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding !HasDevices}" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Text="On this computer" Classes="heading" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="Serial ports, with the USB device on each when the computer says. Add the one your device is plugged into; it's named after the port until you rename it." />
        <Button Content="Look again" Command="{Binding RefreshPortsCommand}" ToolTip.Tip="List the ports again, after plugging in a USB cable" />
        <TextBlock Text="{Binding FoundStatus}" TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding !!FoundStatus.Length}" />
        <ItemsControl x:Name="FoundPorts" ItemsSource="{Binding Found}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FoundPort">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add" IsEnabled="{Binding CanAdd}" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:InputsViewModel)DataContext).AddCommand}" CommandParameter="{Binding}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Note}" Opacity="0.7" IsVisible="{Binding !CanAdd}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <views:InputMonitorView Grid.Row="1" Margin="0,16,0,0" DataContext="{Binding Monitor}" />
  </Grid>
</UserControl>
