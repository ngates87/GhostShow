<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             xmlns:controls="using:GhostShow.App.Controls"
             xmlns:dmx="using:GhostShow.Core.Dmx"
             x:Class="GhostShow.App.Views.OutputsView"
             x:DataType="vm:OutputsViewModel">
  <!-- DMX setup: the show's universes (left) and the adapters on the show computer (right), drawn with the same device
       cards as the Inputs screen. -->
  <Grid ColumnDefinitions="1.5*,16,*" Margin="0,12">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <TextBlock Text="Universes" Classes="heading" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="Universe numbers and names belong to the show. The device each one goes out on belongs to the show computer, so a show opened elsewhere keeps its patch but uses that machine's hardware." />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Add universe" Command="{Binding AddUniverseCommand}" />
          <Button Classes="icon" Command="{Binding History.UndoCommand}" ToolTip.Tip="{Binding History.UndoLabel}"><PathIcon Data="{StaticResource Icon.Undo}" /></Button>
          <Button Classes="icon" Command="{Binding History.RedoCommand}" ToolTip.Tip="{Binding History.RedoLabel}"><PathIcon Data="{StaticResource Icon.Redo}" /></Button>
        </StackPanel>
      </StackPanel>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Universes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UniverseRowViewModel">
              <controls:DeviceCard Icon="{StaticResource Icon.Dmx}" Kind="{Binding Summary}" State="{Binding State}" StatusText="{Binding Status}"
                                   IsExpanded="{Binding IsExpanded}">
                <controls:DeviceCard.Title>
                  <TextBox Classes="deviceName" Text="{Binding Name}" ToolTip.Tip="The universe's name. Click to rename." />
                </controls:DeviceCard.Title>
                <controls:DeviceCard.Actions>
                  <Button Content="Remove"
                          Command="{Binding $parent[ItemsControl].((vm:OutputsViewModel)DataContext).RemoveUniverseCommand}"
                          CommandParameter="{Binding}" />
                </controls:DeviceCard.Actions>
                <!-- Settings, behind the card's expander -->
                <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,6,Auto">
                  <TextBlock Text="Number" VerticalAlignment="Center" Opacity="0.7" />
                  <NumericUpDown Grid.Column="2" Width="130" HorizontalAlignment="Left" Minimum="1" Maximum="63999" Increment="1" FormatString="0"
                                 Value="{Binding Number}" />
                  <TextBlock Grid.Row="2" Text="Output device" VerticalAlignment="Center" Opacity="0.7"
                             ToolTip.Tip="On the show computer: this machine's setting, not the show's" />
                  <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="The adapter this universe goes out on, on the show computer" />
                </Grid>
              </controls:DeviceCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <TextBlock Text="USB DMX adapters on the show computer" Classes="heading" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="Enttec DMX USB Pro and compatibles, and Open DMX adapters (Enttec Open DMX USB, most cheap FTDI-based cables). While this screen is open, adapters are found automatically when plugged in. A newly connected port is briefly checked; ports in use by an output are never touched." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Scan again" Command="{Binding ScanAgainCommand}"
                  ToolTip.Tip="Forget what's been found and check every port again" />
        </StackPanel>
        <TextBlock Text="{Binding DetectStatus}" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Adapters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dmx:AdapterRow">
              <controls:DeviceCard Classes="compact" Icon="{StaticResource Icon.Dmx}" Title="{Binding Name}" Kind="{Binding Summary}"
                                   StatusText="{Binding Assignment}" State="{Binding InUse, Converter={x:Static vm:Converters.FoundState}}"
                                   ToolTip.Tip="{Binding Description}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
