<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             x:Class="GhostShow.App.Views.ButtonsPanel"
             x:DataType="vm:ButtonsViewModel">
  <!-- The show's buttons, beside the timeline (self-contained, so it can become a dockable window later). -->
  <UserControl.Styles>
    <Style Selector="Button.showButton">
      <Setter Property="Width" Value="116" />
      <Setter Property="Height" Value="68" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.showButton Border.face">
      <Setter Property="BorderBrush" Value="#30FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Lit: a timeline it runs is playing. -->
    <Style Selector="Button.showButton.lit Border.face">
      <Setter Property="BorderBrush" Value="Gold" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Button.showButton.selected Border.face">
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- While editing, the tiles keep to the top so the editor sits right under them. -->
    <Style Selector="ScrollViewer.tiles.editing">
      <Setter Property="MaxHeight" Value="230" />
    </Style>
    <Style Selector="ToggleButton.arming">
      <Setter Property="Background" Value="#B71C1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.arming:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B5E20" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- Folded away: a strip at the edge to bring it back. -->
    <Button IsVisible="{Binding !IsOpen}" Command="{Binding ToggleOpenCommand}" VerticalAlignment="Stretch" Padding="4,8" Margin="6,0,0,0"
            ToolTip.Tip="Show the buttons">
      <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
          <RotateTransform Angle="90" />
        </LayoutTransformControl.LayoutTransform>
        <TextBlock Text="Buttons ▾" />
      </LayoutTransformControl>
    </Button>

    <Border Classes="card" Width="268" Margin="8,0,0,0" Padding="8" IsVisible="{Binding IsOpen}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Classes="small" Content="»" Command="{Binding ToggleOpenCommand}" Margin="4,0,0,0" ToolTip.Tip="Fold the buttons away" />
          <Button DockPanel.Dock="Right" Classes="small" Content="+" Command="{Binding AddCommand}" Margin="4,0,0,0" ToolTip.Tip="Add a button" />
          <ToggleButton DockPanel.Dock="Right" Classes="small" Content="{Binding EditLabel}" IsChecked="{Binding IsEditing}" Padding="8,1" MinHeight="0"
                        ToolTip.Tip="Edit mode (or right-click a button): click a button to change its name, colour, triggers and actions (instead of pressing it). Done, or Esc, finishes." />
          <TextBlock Text="Buttons" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <!-- Arming: on when a show opens; off while working on it. Red when off, so it isn't forgotten. -->
        <ToggleButton DockPanel.Dock="Top" Classes="arming" IsChecked="{Binding TriggersArmed}" Content="{Binding ArmedLabel}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6" Padding="6,2" MinHeight="0"
                      ToolTip.Tip="Off: keys and other triggers don't press buttons (clicking still does), for working on the show. Not saved: a show always opens armed." />
        <TextBlock DockPanel.Dock="Top" Text="Editing: click a button to choose it. Done or Esc when finished." FontSize="12" Opacity="0.75"
                   TextWrapping="Wrap" Margin="0,0,0,6" IsVisible="{Binding IsEditing}" />

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- The buttons -->
        <ScrollViewer DockPanel.Dock="Top" Classes="tiles" Classes.editing="{Binding IsEditing}">
          <StackPanel>
            <TextBlock Text="No buttons yet. + adds one: give it actions (Run timeline, Stop, Blackout…) and keys." TextWrapping="Wrap" Opacity="0.7"
                       IsVisible="{Binding !HasButtons}" />
            <ItemsControl ItemsSource="{Binding Buttons}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShowButtonViewModel">
                  <Button Classes="showButton" Classes.lit="{Binding IsLit}" Classes.selected="{Binding IsSelected}" Command="{Binding ClickCommand}"
                          ToolTip.Tip="{Binding Name}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Edit" Command="{Binding OpenEditorCommand}" />
                        <MenuItem Header="Add key…" Command="{Binding AddKeyFromMenuCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Border Classes="face" Background="{Binding Color}" CornerRadius="6" Padding="6,4">
                      <Grid RowDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="White" />
                        <TextBlock Grid.Row="1" Text="{Binding KeyLabel}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.85" Foreground="White" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- What's playing: kept at the bottom of the drawer, below the button list/editor. -->
        <Border DockPanel.Dock="Bottom" Classes="card" Height="180" Margin="0,8,0,0" Padding="8"
                IsVisible="{Binding !!Playback.Running.Count}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Classes="small" Content="Stop all" Command="{Binding Playback.StopAllCommand}"
                      ToolTip.Tip="Stop every timeline and release the held lights" />
              <TextBlock Text="Playing" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Playback.Running}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RunningRowViewModel">
                    <DockPanel Margin="0,1">
                      <Button DockPanel.Dock="Right" Classes="small" Content="■" Command="{Binding StopCommand}" ToolTip.Tip="{Binding StopTip}" />
                      <Button Command="{Binding OpenCommand}" Background="Transparent" Padding="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              ToolTip.Tip="Open it in the editor" IsHitTestVisible="{Binding !IsHeld}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="{Binding IsFocused, Converter={x:Static vm:Converters.BoldWhen}}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Editing the selected button: right under the tiles, filling the rest of the panel -->
        <Border BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,8,0,0" IsVisible="{Binding IsEditing}">
        <ScrollViewer>
          <ContentControl Content="{Binding Selected}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ShowButtonViewModel">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="accent" Content="Done" Command="{Binding DoneCommand}" Padding="12,2" MinHeight="0"
                            ToolTip.Tip="Finish editing (Esc): clicks press buttons again" />
                    <TextBlock Text="{Binding Name, StringFormat='Editing {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Text="Name" Opacity="0.75" />
                  <TextBox Text="{Binding Name}" />
                  <WrapPanel>
                    <ItemsControl ItemsSource="{x:Static vm:ButtonsViewModel.Palette}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Button Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,4,4" Background="Transparent"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip.Tip="{Binding}"
                                  Command="{Binding $parent[ContentControl].((vm:ShowButtonViewModel)DataContext).PickColorCommand}" CommandParameter="{Binding}">
                            <Border Background="{Binding}" CornerRadius="3" BorderBrush="#80FFFFFF" BorderThickness="1" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </WrapPanel>
                  <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Classes="small" Classes.accent="{Binding IsLearningKey}" Content="{Binding LearnKeyLabel}" Command="{Binding LearnKeyCommand}"
                            ToolTip.Tip="Then press the key. Pressing it anywhere in GhostShow presses this button (not while typing in a field)." />
                    <TextBlock Text="Triggers" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="None yet: only a click presses it." Opacity="0.6" FontSize="12" IsVisible="{Binding !Triggers.Count}" />
                  <ItemsControl ItemsSource="{Binding Triggers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonTriggerViewModel">
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="6,3" Margin="0,0,0,4">
                          <StackPanel Spacing="2">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Classes="small" Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this trigger" />
                              <CheckBox DockPanel.Dock="Right" Content="On" IsChecked="{Binding IsOn}" MinHeight="0" Margin="0,0,6,0"
                                        ToolTip.Tip="Off: this trigger does nothing until it's turned back on or the show is reopened (not saved). For a sensor that misbehaves mid-show." />
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding State}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            <Expander HorizontalAlignment="Stretch" Padding="4" MinHeight="0" FontSize="12">
                              <Expander.Header>
                                <TextBlock Text="{Binding RearmSummary}" TextWrapping="Wrap" />
                              </Expander.Header>
                              <StackPanel Spacing="4">
                                <DockPanel>
                                  <NumericUpDown DockPanel.Dock="Right" Width="110" Value="{Binding RearmSeconds}" Minimum="0" Increment="0.5" FormatString="0.##"
                                                 ToolTip.Tip="After firing it does nothing for this long, so a flickering sensor or a passing crowd doesn't fire it again and again. 0: as soon as it's let go." />
                                  <TextBlock Text="Re-arm time (s)" VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox Content="Count from when its timelines finish" IsChecked="{Binding RearmAfterTimelines}"
                                          ToolTip.Tip="On: it waits until the timelines this button started have finished (release fade included), then the re-arm time. Off: the re-arm time counts from when it fires." />
                              </StackPanel>
                            </Expander>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding KeyProblem}" Classes="fault" TextWrapping="Wrap" FontSize="12"
                             IsVisible="{Binding KeyProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Classes="small" Content="Add action ▾">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Run timeline" Command="{Binding AddActionCommand}" CommandParameter="run" />
                          <MenuItem Header="Stop timeline" Command="{Binding AddActionCommand}" CommandParameter="stop" />
                          <MenuItem Header="Stop all timelines" Command="{Binding AddActionCommand}" CommandParameter="stopAll" />
                          <MenuItem Header="Blackout" Command="{Binding AddActionCommand}" CommandParameter="blackout" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <TextBlock Text="Actions (in order)" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="None yet: pressing it does nothing." Opacity="0.6" FontSize="12" IsVisible="{Binding !Actions.Count}" />
                  <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonActionViewModel">
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                          <StackPanel Spacing="4">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Classes="small" Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this action" />
                              <Button DockPanel.Dock="Right" Classes="small" Content="↓" Command="{Binding MoveLaterCommand}" ToolTip.Tip="Later" />
                              <Button DockPanel.Dock="Right" Classes="small" Content="↑" Command="{Binding MoveEarlierCommand}" ToolTip.Tip="Earlier" />
                              <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Timelines}" SelectedItem="{Binding Timeline}" HorizontalAlignment="Stretch"
                                      IsVisible="{Binding HasTimeline}" PlaceholderText="(its timeline was deleted)" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <WrapPanel Margin="0,6,0,0">
                    <Button Classes="small" Content="◂" Command="{Binding MoveEarlierCommand}" Margin="0,0,4,4" ToolTip.Tip="Move earlier in the panel" />
                    <Button Classes="small" Content="▸" Command="{Binding MoveLaterCommand}" Margin="0,0,4,4" ToolTip.Tip="Move later in the panel" />
                    <Button Classes="small" Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,4,4" />
                    <Button Classes="small" Content="Delete…" Margin="0,0,4,4">
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Name, StringFormat='Delete {0}? (No undo for buttons yet.)'}" />
                            <Button Content="Delete" Command="{Binding RemoveCommand}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
        </Border>

      </DockPanel>
    </Border>
  </Panel>
</UserControl>
