<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             xmlns:views="using:GhostShow.App.Views"
             x:Class="GhostShow.App.Views.MainView"
             x:DataType="vm:ShellViewModel">
  <!-- Everything inside the window: menus, sections and pages, the Buttons panel, the status bar. The desktop window
       hosts it, and so does a device's browser page (see docs/plan-shared-view.md), so each part is built once. What
       differs is in ShellViewModel's places (HomePage, AudioPage, ButtonsPart…), which each host's App.axaml fills
       with its own data templates. -->
  <DockPanel>
    <!-- Menu bar, with what needs attention and Blackout at its right (on every screen; Blackout even with no show
         open). The transport and time are under the timeline. -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,2" VerticalAlignment="Center">
        <ContentControl Content="{Binding MenuBarPart}" VerticalAlignment="Center" />
        <!-- Problems worth knowing about (patch errors, failing outputs); only there when there are some. -->
        <Button Padding="10,3" Background="#5A3A00" IsVisible="{Binding !!Warnings.Count}"
                ToolTip.Tip="Things that need attention">
          <TextBlock><Run Text="⚠ " /><Run Text="{Binding Warnings.Count}" /></TextBlock>
          <Button.Flyout>
            <Flyout>
              <ItemsControl ItemsSource="{Binding Warnings}" MaxWidth="420">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- Triggers are off: easy to forget after working on the show, so it shows on every screen. Triggers fire
             only on the show computer, so only it says so. -->
        <Panel IsVisible="{Binding IsShowOpen}">
          <Panel IsVisible="{Binding IsShowComputer}">
          <Button x:Name="TriggersOffButton" Content="Triggers off" Command="{Binding Buttons.ToggleArmedCommand}" IsVisible="{Binding !Buttons.TriggersArmed}"
                  Background="#B71C1C" Foreground="White" Padding="10,3"
                  ToolTip.Tip="Keys and other triggers don't press buttons. Click to arm them." />
          </Panel>
        </Panel>
        <Button Content="Blackout" Command="{Binding BlackoutCommand}"
                ToolTip.Tip="Stop playback and set every channel of every universe to 0 (Ctrl+B)"
                Background="DarkRed" Foreground="White" FontWeight="SemiBold" Padding="16,3" />
      </StackPanel>
      <!-- Shortcut keys shown in the menus are handled by the window (file, view) or the timeline screen (editing,
           Space for play/pause), so they work whether or not the menu is open. -->
      <Menu>
      <MenuItem Header="_File" IsVisible="{Binding IsEditor}">
        <MenuItem Header="_New Show" InputGesture="Ctrl+N" Command="{Binding NewCommand}" />
        <MenuItem Header="_Open Show…" InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <MenuItem Header="_Import VenueMagic Project…" Command="{Binding ImportVenueMagicCommand}" IsVisible="{Binding IsShowComputer}" />
        <MenuItem Header="Open _Recent" Classes="recentRoot" ItemsSource="{Binding RecentShows}" IsEnabled="{Binding !!RecentShows.Count}" IsVisible="{Binding IsShowComputer}">
          <MenuItem.Styles>
            <Style Selector="MenuItem:not(.recentRoot)" x:DataType="vm:RecentShowRow">
              <Setter Property="Header" Value="{Binding Path}" />
              <Setter Property="IsEnabled" Value="{Binding Exists}" />
              <Setter Property="Command" Value="{Binding $parent[views:MainView].((vm:ShellViewModel)DataContext).OpenRecentCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="Open Older Show _File (.json)…" Command="{Binding OpenOldShowCommand}" IsVisible="{Binding IsShowComputer}" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" IsVisible="{Binding IsShowComputer}" />
        <MenuItem Header="_Rename…" Command="{Binding RenameCommand}" IsVisible="{Binding !IsShowComputer}" />
        <MenuItem Header="Copy _Audio Into Show Folder" Command="{Binding CollectAudioCommand}" IsVisible="{Binding IsShowComputer}"
                  ToolTip.Tip="Copies sounds the show uses from elsewhere (another drive, Google Drive, …) into its audio folder, so the folder holds everything and plays from the local disk" />
        <Separator IsVisible="{Binding IsShowComputer}" />
        <MenuItem Header="_Close Show" InputGesture="Ctrl+W" Command="{Binding CloseShowCommand}" IsVisible="{Binding IsShowComputer}" />
        <Separator IsVisible="{Binding IsShowComputer}" />
        <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Command="{Binding ExitCommand}" IsVisible="{Binding IsShowComputer}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding Timeline.UndoLabel}" InputGesture="Ctrl+Z" Command="{Binding Timeline.UndoCommand}" />
        <MenuItem Header="{Binding Timeline.RedoLabel}" InputGesture="Ctrl+Y" Command="{Binding Timeline.RedoCommand}" />
        <Separator />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding Timeline.CopyCommand}" />
        <MenuItem Header="_Paste at Playhead" InputGesture="Ctrl+V" Command="{Binding Timeline.PasteCommand}" />
        <MenuItem Header="_Duplicate" InputGesture="Ctrl+D" Command="{Binding Timeline.DuplicateCommand}" />
        <MenuItem Header="De_lete" InputGesture="Delete" Command="{Binding Timeline.DeleteCommand}" />
        <Separator />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Command="{Binding Timeline.SelectAllCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Timeline" InputGesture="Ctrl+1" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Timeline}" />
        <MenuItem Header="_Lighting">
          <MenuItem Header="_DMX Setup" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.DmxSetup}" />
          <MenuItem Header="_Fixtures" InputGesture="Ctrl+2" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Fixtures}" />
          <MenuItem Header="_Control" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Control}" />
          <MenuItem Header="C_hannels" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Channels}" />
          <MenuItem Header="_Monitor" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Monitor}" />
        </MenuItem>
        <MenuItem Header="_Audio" InputGesture="Ctrl+3" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Audio}" />
        <MenuItem Header="I_nputs" InputGesture="Ctrl+4" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.InputMonitor}" />
        <MenuItem Header="D_iagnostics" InputGesture="Ctrl+5" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Diagnostics}" />
        <MenuItem Header="_Remote Access…" Command="{Binding ShowRemoteAccessCommand}" IsVisible="{Binding IsShowComputer}" />
        <Separator />
        <MenuItem Header="Zoom _In" Command="{Binding Timeline.ZoomInCommand}" />
        <MenuItem Header="Zoom _Out" Command="{Binding Timeline.ZoomOutCommand}" />
      </MenuItem>
      <MenuItem Header="_Playback">
        <MenuItem Header="{Binding Playback.PlayPauseLabel}" InputGesture="Space" Command="{Binding Playback.PlayPauseCommand}" />
        <MenuItem Header="_Stop" Command="{Binding Playback.StopCommand}" />
        <MenuItem Header="Play from _Start" Command="{Binding Playback.RestartCommand}" />
        <MenuItem Header="Stop _All Timelines" Command="{Binding Playback.StopAllCommand}" />
        <Separator />
        <MenuItem Header="_Blackout" InputGesture="Ctrl+B" Command="{Binding BlackoutCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About GhostShow" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>
    </DockPanel>

    <!-- Armed key triggers, but another window has the keyboard: they can't work, so say so loudly. Only on the show
         computer: a device's keyboard never fires triggers. -->
    <Panel DockPanel.Dock="Top" IsVisible="{Binding IsShowComputer}">
      <Border Background="#B71C1C" Padding="12,6" IsVisible="{Binding Buttons.ShowFocusWarning}">
        <TextBlock Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="GhostShow isn't the active window, so its trigger keys won't work. Click anywhere in GhostShow to bring them back." />
      </Border>
    </Panel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <ContentControl DockPanel.Dock="Right" Content="{Binding StatusPart}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Library.Summary}" Opacity="0.7" />
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- With a show open: Timeline, Lighting (its own row of screens, see LightingView), Audio, Inputs, Diagnostics. The tab
         strip only chooses the page; every screen below stays built and is just shown or hidden, so switching is instant. -->
    <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0" IsVisible="{Binding IsShowOpen}">
      <TabStrip Classes="sections" SelectedIndex="{Binding SelectedSection}">
        <TabStripItem Content="Timeline" />
        <TabStripItem Content="Lighting" />
        <TabStripItem Content="Audio" />
        <TabStripItem Content="Inputs" />
        <TabStripItem Content="Diagnostics" />
      </TabStrip>
    </StackPanel>

    <!-- Getting started (the show computer's, while the show isn't set up yet) -->
    <ContentControl DockPanel.Dock="Top" Content="{Binding GuidePart}" />

    <Panel Margin="8,0,8,0">
      <ContentControl Content="{Binding HomePage}"
                      IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Home}}" />
      <!-- The timeline, with the show's buttons beside it -->
      <DockPanel IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Timeline}}">
        <ContentControl x:Name="ButtonsPart" DockPanel.Dock="Right" Content="{Binding ButtonsPart}" />
        <views:TimelineView DataContext="{Binding Timeline}"
                            BottomWorkspace="{Binding $parent[views:MainView].((vm:ShellViewModel)DataContext).BottomWorkspace}" />
      </DockPanel>
      <ContentControl Content="{Binding DiagnosticsPage}"
                      IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Diagnostics}}" />
      <views:LightingView DataContext="{Binding Lighting}"
                          IsVisible="{Binding $parent[views:MainView].((vm:ShellViewModel)DataContext).SelectedSection, Converter={x:Static vm:Converters.SectionIs}, ConverterParameter={x:Static vm:Section.Lighting}}" />
      <ContentControl Content="{Binding InputsPage}"
                      IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.InputMonitor}}" />
      <ContentControl Content="{Binding AudioPage}"
                      IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Audio}}" />
    </Panel>
  </DockPanel>
</UserControl>
