<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Silent test audio, generated for these tests (see Assets/Audio/README.md). -->
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\GhostShow.Audio\GhostShow.Audio.csproj" />
    <ProjectReference Include="..\..\libs\GhostShow.Core\GhostShow.Core.csproj" />
    <ProjectReference Include="..\..\libs\GhostShow.Dmx\GhostShow.Dmx.csproj" />
    <ProjectReference Include="..\..\libs\GhostShow.Web\GhostShow.Web.csproj" />
  </ItemGroup>
</Project>
