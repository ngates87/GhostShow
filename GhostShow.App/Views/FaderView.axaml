<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             xmlns:controls="using:GhostShow.App.Controls"
             x:Class="GhostShow.App.Views.FaderView"
             x:DataType="vm:FaderViewModel"
             Width="92">
  <!-- One fader module, laid out like a console fader wing: scribble strip, fader, then the keys below it. -->
  <Border Classes="faderModule" Margin="0,0,6,6">
    <StackPanel Spacing="6">
      <!-- While the playing timeline controls the channel: orange outline, and the DMX line says so (same height, so nothing moves). -->
      <Border Classes="scribble" Classes.timeline="{Binding IsTimelineControlled}"
              ToolTip.Tip="{Binding TimelineTip}">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding Label}" Classes="scribbleName" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Caption}" Classes="scribbleSmall" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                     IsVisible="{Binding Caption, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Level}" Classes="scribbleLevel" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding DmxValue}" Classes="scribbleSmall" HorizontalAlignment="Center" IsVisible="{Binding !IsTimelineControlled}" />
          <TextBlock Text="TIMELINE" Classes="scribbleSmall" Foreground="#FFA726" FontWeight="Bold"
                     HorizontalAlignment="Center" IsVisible="{Binding IsTimelineControlled}" />
        </StackPanel>
      </Border>
      <controls:ConsoleFader Value="{Binding Value}" Height="200" />
      <UniformGrid Columns="2">
        <Button Content="FL" Classes="consoleKey" Command="{Binding FullCommand}" Margin="0,0,2,0" ToolTip.Tip="Full (255)" />
        <Button Content="0" Classes="consoleKey" Command="{Binding ZeroCommand}" Margin="2,0,0,0" ToolTip.Tip="Zero" />
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
