<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             x:Class="GhostShow.App.Views.FaderView"
             x:DataType="vm:FaderViewModel"
             Width="86">
  <Border Classes="card" Padding="6" Margin="0,0,6,6">
    <StackPanel Spacing="4" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Caption}" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                 IsVisible="{Binding Caption, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Content="Full" Command="{Binding FullCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="2" />
      <Slider Orientation="Vertical" Height="180" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
              Value="{Binding Value}" HorizontalAlignment="Center" />
      <Button Content="0" Command="{Binding ZeroCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="2" />
      <TextBlock HorizontalAlignment="Center">
        <Run Text="{Binding Value, StringFormat='{}{0:0}'}" FontWeight="SemiBold" />
      </TextBlock>
      <TextBlock Text="{Binding Percent}" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
