<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GhostShow.App.ViewModels"
        xmlns:controls="using:GhostShow.App.Controls"
        x:Class="GhostShow.App.Views.RemoteWindow"
        x:DataType="vm:RemoteViewModel"
        Title="Remote Access"
        Icon="avares://ghostshow-app/Assets/ghostshow.ico"
        Width="620" Height="640" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Remote Access" FontSize="20" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="Run and tweak the show from an iPad, laptop or phone on this computer's network: open the address in its browser and pair it with the PIN. Sound and lights stay here." />
      </StackPanel>

      <Border Classes="card" Padding="14" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <DockPanel>
          <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" OnContent="On" OffContent="Off" VerticalAlignment="Center"
                        ToolTip.Tip="Off: nothing on the network can reach GhostShow" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Let devices on this network connect" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- On: where to go, and the PIN -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" IsVisible="{Binding IsOn}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Open in the device's browser" Opacity="0.75" />
            <ItemsControl ItemsSource="{Binding Addresses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Text="{Binding}" FontFamily="monospace" FontSize="16" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding FullAppAddress, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="The full app (timelines, editing), on a laptop" Opacity="0.75" />
            <SelectableTextBlock Text="{Binding FullAppAddress}" FontFamily="monospace" FontSize="16" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="PIN" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <SelectableTextBlock x:Name="PinText" Text="{Binding Pin}" FontFamily="monospace" FontSize="34" FontWeight="Bold" LetterSpacing="4" VerticalAlignment="Center" />
              <Button Content="New PIN" Command="{Binding NewPinCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="Devices already paired stay paired; new ones need the new PIN" />
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                     Text="On an iPad, add it to the Home Screen (Share → Add to Home Screen) for a full-screen app, and set Auto-Lock to Never while you work." />
        </StackPanel>
        <Border Grid.Column="1" Width="170" Height="170" VerticalAlignment="Top" ToolTip.Tip="Point the device's camera at it to open the address">
          <controls:QrCodeView Text="{Binding QrText}" />
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsOn}">
        <TextBlock Text="Port" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" Width="140"
                       ToolTip.Tip="The network port devices connect to (7700 unless something else uses it)" />
      </StackPanel>

      <!-- Paired devices -->
      <StackPanel Spacing="8">
        <TextBlock Text="Paired devices" FontWeight="SemiBold" />
        <TextBlock Text="None yet." Opacity="0.6" IsVisible="{Binding !Devices.Count}" />
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RemoteDeviceRow">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,4">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#5FCF80" IsVisible="{Binding IsConnected}" />
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#555" IsVisible="{Binding !IsConnected}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Seen}" Opacity="0.65" FontSize="12" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:RemoteDeviceRow.Roles}" SelectedIndex="{Binding RoleIndex}" Width="120" VerticalAlignment="Center"
                          ToolTip.Tip="Editor: everything. Operator: start and stop the show and see how it's doing, no editing." />
                <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Disconnects it; it has to pair again (with the PIN) to come back" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
