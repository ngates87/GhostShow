<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostShow.App.ViewModels"
             xmlns:tl="using:GhostShow.Core.Timeline"
             xmlns:controls="using:GhostShow.App.Controls"
             x:Class="GhostShow.App.Views.TimelineView"
             x:DataType="vm:TimelineEditorViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.tracks > ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem">
      <Setter Property="Padding" Value="10,4,4,4" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="Background" Value="#1E1F23" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#2D4A66" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="230,6,*" Margin="0,8">
    <!-- The show's timelines: the tree is the show folder's timelines/ directory -->
    <Border Classes="card" Padding="6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="2,0,0,6">
          <TextBlock Text="Timelines" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="+ Timeline" Command="{Binding Tree.NewTimelineCommand}" Padding="6,2"
                    ToolTip.Tip="New timeline in the selected folder" />
            <Button Content="+ Folder" Command="{Binding Tree.NewFolderCommand}" Padding="6,2"
                    ToolTip.Tip="New folder in the selected folder" />
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Classes="confirm" Margin="0,6,0,0" IsVisible="{Binding Tree.IsConfirmingDelete}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Tree.DeleteQuestion}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Delete" Command="{Binding Tree.DeleteCommand}" Background="DarkRed" Foreground="White" />
              <Button Content="Cancel" Command="{Binding Tree.CancelDeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Tree.Message}" Classes="fault" TextWrapping="Wrap" Margin="0,6,0,0"
                   IsVisible="{Binding Tree.Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Bottom" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                   Text="Double-click to open · F2 rename · drag to move into a folder · files follow on Save" />
        <!-- What's playing: several timelines can play at once -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding !!Playback.Running.Count}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Stop all" Command="{Binding Playback.StopAllCommand}" Padding="6,1" MinHeight="0" />
            <TextBlock Text="Playing" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Playback.Running}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RunningRowViewModel">
                <DockPanel Margin="0,1">
                  <Button DockPanel.Dock="Right" Content="■" Command="{Binding StopCommand}" Padding="6,0" MinHeight="0" ToolTip.Tip="Stop it (it releases its channels)" />
                  <Button Command="{Binding OpenCommand}" Background="Transparent" Padding="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="Open it in the editor">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="{Binding IsFocused, Converter={x:Static vm:Converters.BoldWhen}}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TreeView x:Name="TimelineTree" ItemsSource="{Binding Tree.Roots}" SelectedItem="{Binding Tree.SelectedNode}"
                  DragDrop.AllowDrop="True" Background="Transparent">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:TimelineTreeNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="MinHeight" Value="26" />
            </Style>
          </TreeView.Styles>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Command="{Binding Tree.OpenCommand}" />
              <MenuItem Header="Rename" InputGesture="F2" Command="{Binding Tree.StartRenameCommand}" />
              <MenuItem Header="Duplicate" Command="{Binding Tree.DuplicateCommand}" />
              <MenuItem Header="Move to" Classes="moveRoot" ItemsSource="{Binding Tree.MoveTargets}">
                <MenuItem.Styles>
                  <Style Selector="MenuItem:not(.moveRoot)" x:DataType="vm:MoveTarget">
                    <Setter Property="Header" Value="{Binding Label}" />
                    <Setter Property="Command" Value="{Binding Move}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <Separator />
              <MenuItem Header="New timeline here" Command="{Binding Tree.NewTimelineCommand}" />
              <MenuItem Header="New folder here" Command="{Binding Tree.NewFolderCommand}" />
              <Separator />
              <MenuItem Header="Delete…" InputGesture="Delete" Command="{Binding Tree.AskDeleteCommand}" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:TimelineTreeNode" ItemsSource="{Binding Children}">
              <Panel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}" Background="Transparent">
                  <!-- Folder or timeline icon -->
                  <Path Width="16" Height="14" Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding IsFolder}"
                        Fill="#C9A227" Data="M0,2 L6,2 L8,4 L16,4 L16,14 L0,14 Z" />
                  <Path Width="16" Height="14" Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding !IsFolder}"
                        Stroke="#6FA8DC" StrokeThickness="2" Data="M0,2 L16,2 M0,7 L16,7 M0,12 L10,12" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Classes="rename" Text="{Binding EditName}" IsVisible="{Binding IsEditing}" MinHeight="0" Padding="4,1" />
              </Panel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

  <DockPanel Grid.Column="2">
    <!-- Open timelines, as tabs; the selected one is edited and played -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Classes="toolbar"
                  IsVisible="{Binding SelectedTimeline, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button ToolTip.Tip="How this timeline plays alongside others: priority, overriding, release">
          <TextBlock MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlaybackSummary}"><Run Text="⚙ Playback: " /><Run Text="{Binding PlaybackSummary}" /></TextBlock>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="8" Width="340">
                <TextBlock Text="Playing alongside other timelines" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                           Text="Several timelines can play at once. Where two set the same channel, the higher priority wins (equal: the one started last). A timeline with a higher priority overrides lower ones: only on the channels it uses." />
                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                  <TextBlock Text="Priority" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding Priority}" Minimum="-100" Maximum="1000" Increment="1" FormatString="0"
                                 ToolTip.Tip="0 for ordinary timelines (ambients); e.g. 10 for scares, 100 for an emergency look" />
                  <TextBlock Grid.Row="2" Text="What it overrides" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding PauseOverridden}" OnContent="Pauses" OffContent="Keeps running"
                                ToolTip.Tip="Pauses: lower timelines sharing a channel pause, and resume where they were when this ends. Keeps running: they carry on underneath, out of sight." />
                  <TextBlock Grid.Row="4" Text="Release fade (s)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding ReleaseFadeSeconds}" Minimum="0" Increment="0.5" FormatString="0.0#"
                                 ToolTip.Tip="When it stops, its channels fade back to what's underneath over this time (0: snap)" />
                  <TextBlock Grid.Row="6" Text="Other sounds while it plays (%)" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding DuckPercent}" Minimum="0" Maximum="100" Increment="5" FormatString="0"
                                 ToolTip.Tip="Lower-priority timelines' sounds play at this volume while this one plays (100: untouched)" />
                  <TextBlock Grid.Row="8" Text="At the end" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Row="8" Grid.Column="1" IsChecked="{Binding ReleaseAtEnd}" OnContent="Releases" OffContent="Holds"
                                ToolTip.Tip="Releases: lets go of its channels when it ends (not looping), so what's underneath comes back. Holds: keeps its final look." />
                </Grid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Text="Length (s)" Classes="label" Margin="8,0,0,0" />
        <NumericUpDown Value="{Binding LengthSeconds}" Minimum="0" Increment="1" FormatString="0.##" Width="120"
                       ToolTip.Tip="0 = until the last event ends" />
      </StackPanel>
      <ListBox Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TimelineTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding ToolTip}">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <Button Content="×" Padding="5,0" MinHeight="0" Background="Transparent" ToolTip.Tip="Close (the timeline stays in the show)"
                      Command="{Binding $parent[UserControl].((vm:TimelineEditorViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Editing tools -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" Classes="toolbar">
      <Button Content="Add track ▾">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="Lighting track" Command="{Binding AddTrackCommand}" CommandParameter="{x:Static tl:TrackKind.Lighting}" />
            <MenuItem Header="Audio track" Command="{Binding AddTrackCommand}" CommandParameter="{x:Static tl:TrackKind.Audio}" />
            <MenuItem Header="Event track" Command="{Binding AddTrackCommand}" CommandParameter="{x:Static tl:TrackKind.Event}"
                      ToolTip.Tip="Events that run or stop other timelines when the playhead gets to them" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Command="{Binding AddEventCommand}" MinWidth="90" IsVisible="{Binding IsAddButtonShown}"
              ToolTip.Tip="Add a sound or an event to the selected track at the playhead (or double-click a row, or right-click → Add here)">
        <TextBlock Text="{Binding AddLabel}" />
      </Button>
      <Button ToolTip.Tip="Add a Level Control clip or a built-in effect at the playhead, on the selected lighting track">
        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource Icon.Effect}" Width="14" Height="14" /><TextBlock Text="Effects ▾" /></StackPanel>
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="Level Control" Command="{Binding AddLevelControlCommand}" ToolTip.Tip="Envelopes you shape yourself, handle by handle" />
            <Separator />
            <MenuItem Header="Lightning" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Lightning}" ToolTip.Tip="Strikes of cold flickering flashes" />
            <MenuItem Header="Brown out" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.BrownOut}" ToolTip.Tip="The power sags, stutters and drops out" />
            <MenuItem Header="Explosion" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Explosion}" ToolTip.Tip="A blinding flash, then a dying fireball glow" />
            <MenuItem Header="Failing bulb" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Flicker}" ToolTip.Tip="Mostly on, with stuttering drop-outs" />
            <MenuItem Header="Fire" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Fire}" ToolTip.Tip="A warm, restless flicker" />
            <MenuItem Header="Strobe" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Strobe}" ToolTip.Tip="Hard flashes in the dark" />
            <MenuItem Header="Heartbeat" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Heartbeat}" ToolTip.Tip="A lub-dub pulse of colour" />
            <MenuItem Header="Police lights" Command="{Binding AddEffectCommand}" CommandParameter="{x:Static tl:EffectKind.Police}" ToolTip.Tip="Red and blue flashes, taking turns" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Border Classes="separator" />
      <Button Classes="icon" Command="{Binding OpenEnvelopesCommand}"
              ToolTip.Tip="Envelope Editor: edit the selected lighting clip's envelopes (or double-click the clip)">
        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource Icon.Envelope}" /><TextBlock Text="Envelopes" /></StackPanel>
      </Button>
      <Button Classes="icon" Command="{Binding SplitCommand}" ToolTip.Tip="Split the selected clips (or the selected track's) at the playhead">
        <PathIcon Data="{StaticResource Icon.Split}" />
      </Button>
      <Button Classes="icon" Command="{Binding LockCommand}" ToolTip.Tip="Lock or unlock the selected clips (locked clips can't be moved or edited)">
        <PathIcon Data="{StaticResource Icon.Lock}" />
      </Button>
      <Button Classes="icon" Command="{Binding LinkClipsCommand}" IsEnabled="{Binding CanLink}" ToolTip.Tip="Link the selected clips: they move together">
        <PathIcon Data="{StaticResource Icon.Link}" />
      </Button>
      <Button Classes="icon" Command="{Binding UnlinkClipsCommand}" IsEnabled="{Binding CanUnlink}" ToolTip.Tip="Unlink the selected clips">
        <PathIcon Data="{StaticResource Icon.Unlink}" />
      </Button>
      <Border Classes="separator" />
      <Button Classes="icon" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoLabel}"><PathIcon Data="{StaticResource Icon.Undo}" /></Button>
      <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoLabel}"><PathIcon Data="{StaticResource Icon.Redo}" /></Button>
      <Border Classes="separator" />
      <Button Classes="icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl+wheel)"><PathIcon Data="{StaticResource Icon.ZoomOut}" /></Button>
      <Button Classes="icon" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl+wheel)"><PathIcon Data="{StaticResource Icon.ZoomIn}" /></Button>
      <Button Classes="icon" Click="OnZoomToFit" ToolTip.Tip="Show the whole timeline"><PathIcon Data="{StaticResource Icon.Fit}" /></Button>
      <TextBlock Text="Snap" Classes="label" Margin="8,0,0,0" />
      <ComboBox ItemsSource="{x:Static vm:TimelineEditorViewModel.SnapOptions}" SelectedItem="{Binding Snap}" MinWidth="90" />
    </StackPanel>

    <!-- Problems: those events are skipped when playing -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0" MaxHeight="110" IsVisible="{Binding !!Playback.Issues.Count}">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Playback.Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tl:TimelineIssue">
              <TextBlock Text="{Binding Message}" Classes="fault" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <!-- The transport, under the timeline (VenueMagic's place for it) -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" IsVisible="{Binding SelectedTimeline, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
        <Button Classes="icon" Command="{Binding Playback.ToStartCommand}" ToolTip.Tip="Back to the start (Home)">
          <PathIcon Data="{StaticResource Icon.ToStart}" />
        </Button>
        <Button Classes="icon" Command="{Binding Playback.PlayPauseCommand}" ToolTip.Tip="Play or pause (Space)" Padding="12,5">
          <Panel>
            <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Playback.IsPlaying}" />
            <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Playback.IsPlaying}" />
          </Panel>
        </Button>
        <Button Classes="icon" Command="{Binding Playback.StopCommand}" ToolTip.Tip="Stop: audio stops and the lights go back to their manual levels">
          <PathIcon Data="{StaticResource Icon.Stop}" />
        </Button>
        <ToggleButton Classes="icon" IsChecked="{Binding Loop}" ToolTip.Tip="Loop: start again from the beginning at the end">
          <PathIcon Data="{StaticResource Icon.Loop}" />
        </ToggleButton>
        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding Playback.TimeLabel}" FontFamily="monospace" FontSize="15" />
          <TextBlock Text="{Binding Playback.StateLabel}" FontSize="11" Opacity="0.7" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding SelectionLabel}" Opacity="0.75" IsVisible="{Binding !ShowPropertiesHint}" VerticalAlignment="Center" />
      <TextBlock Opacity="0.6" IsVisible="{Binding ShowPropertiesHint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 Text="Double-click a row to add a clip · drag to move · drag edges to resize · double-click a lighting clip to edit its envelopes · ▸ shows them on the track" />
    </DockPanel>

    <!-- The properties panel: the channel picker while it's open, else the selected point or event -->
    <!-- Only there while something is selected (or the channel picker is open), so the lanes get the room otherwise. -->
    <Border DockPanel.Dock="Right" Width="320" Margin="8,0,0,0" Classes="card" IsVisible="{Binding !ShowPropertiesHint}">
      <ScrollViewer>
        <Panel>
          <!-- Channels for a lighting track -->
          <ContentControl Content="{Binding ChannelPicker}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ChannelPickerViewModel">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TrackName, StringFormat='Channels for {0}'}" Classes="heading" TextWrapping="Wrap" />
                    <!-- The patch: picked channels outlined in gold (teal where no fixture is patched); click a fixture to tick it all -->
                    <DockPanel Margin="0,4,0,0" IsVisible="{Binding HasSeveralUniverses}">
                      <TextBlock Text="Universe" Classes="label" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding MapUniverses}" SelectedItem="{Binding MapUniverse}" MinWidth="90" />
                    </DockPanel>
                    <controls:PatchMap Compact="True" Blocks="{Binding MapBlocks}" HighlightedAddresses="{Binding MapHighlights}"
                                       FixtureClickCommand="{Binding ToggleFixtureCommand}" Margin="0,4,0,0"
                                       ToolTip.Tip="Where the picked channels are in the patch. Click a fixture to tick or untick all its channels." />
                    <TextBlock Text="{Binding MapSummary}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock Text="Tick a fixture for all its channels, or expand it for single ones." Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Content="OK" Command="{Binding OkCommand}" Classes="accent" MinWidth="70" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <StackPanel Spacing="6" IsVisible="{Binding !HasFixtures}">
                      <TextBlock Text="No fixtures are patched yet. Patch them first, or use raw DMX channels below."
                                 Opacity="0.8" TextWrapping="Wrap" />
                      <Button Content="Patch fixtures →" Command="{Binding PatchFixturesCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Fixtures}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FixtureChoiceViewModel">
                          <StackPanel>
                            <DockPanel>
                              <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded}" Padding="4,0" MinWidth="0" Background="Transparent"
                                            Content="▸" ToolTip.Tip="Show its channels" />
                              <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="False">
                                <StackPanel>
                                  <TextBlock Text="{Binding Name}" />
                                  <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                              </CheckBox>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Channels}" IsVisible="{Binding IsExpanded}" Margin="34,0,0,4">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChannelChoiceViewModel">
                                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" MinHeight="26" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Raw DMX channels" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <ItemsControl ItemsSource="{Binding Others}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OtherChannelViewModel">
                          <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="×" Padding="6,0" MinHeight="0"
                                    Command="{Binding $parent[ItemsControl].((vm:ChannelPickerViewModel)DataContext).RemoveOtherCommand}" CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,6,Auto">
                      <TextBlock Text="Universe" Classes="label" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Column="1" Grid.ColumnSpan="3" Value="{Binding RawUniverse}" Minimum="1" Maximum="63999" Increment="1" FormatString="0" />
                      <TextBlock Grid.Row="2" Text="From" Classes="label" Margin="0,0,6,0" />
                      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding RawFrom}" Minimum="1" Maximum="512" Increment="1" FormatString="0" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="to" Classes="label" Margin="6,0" />
                      <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding RawTo}" Minimum="1" Maximum="512" Increment="1" FormatString="0" />
                    </Grid>
                    <Button Content="Add raw channels" Command="{Binding AddRawCommand}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <!-- A track's properties -->
          <ContentControl Content="{Binding TrackProperties}" IsVisible="{Binding ChannelPicker, Converter={x:Static ObjectConverters.IsNull}}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:TrackPropertiesViewModel">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseCommand}" Padding="6,0" MinHeight="0" Background="Transparent" ToolTip.Tip="Close" />
                    <TextBlock Text="{Binding Heading}" Classes="heading" />
                  </DockPanel>
                  <TextBlock Text="Name" Classes="label" />
                  <TextBox Text="{Binding Name}" />
                  <StackPanel Spacing="4" IsVisible="{Binding IsAudio}">
                    <TextBlock Text="Output device" Classes="label" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Test" Command="{Binding Row.TestOutputCommand}" Margin="6,0,0,0"
                              ToolTip.Tip="Play a short tone on this output" />
                      <ComboBox ItemsSource="{Binding Row.Outputs}" SelectedItem="{Binding Row.SelectedOutput}" HorizontalAlignment="Stretch"
                                DropDownOpened="OnOutputDropDownOpened" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="The sound card or speakers this track plays on. Saved in the show; on a computer without that device the track plays on the default output (set on the Audio screen)." />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsAudio}">
                    <TextBlock Text="Volume (%)" Classes="label" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Column="1" Value="{Binding VolumePercent}" Minimum="0" Maximum="100" Increment="5" FormatString="0"
                                   ToolTip.Tip="Every clip on this track plays at this much of its own volume, so tracks can be balanced against each other" />
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding IsLighting}">
                    <CheckBox Content="Draw levels between clips" IsChecked="{Binding DrawLevelsBetweenClips}"
                              ToolTip.Tip="Expanded, each channel's held level is drawn as a line between clips" />
                    <DockPanel Margin="0,8,0,0">
                      <Button DockPanel.Dock="Right" Content="Channels…" Command="{Binding EditChannelsCommand}" Padding="6,1" MinHeight="0" />
                      <TextBlock Text="Starting levels" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="Where each channel is from the timeline's start until its first clip. The first clip's envelope starts there; every later clip starts where the one before left the channel." />
                    <TextBlock Text="No channels yet." Opacity="0.7" IsVisible="{Binding !HasChannels}" />
                    <ItemsControl ItemsSource="{Binding Channels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChannelStartViewModel">
                          <StackPanel Spacing="4" Margin="0,6,0,0">
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                            </DockPanel>
                            <ComboBox ItemsSource="{x:Static vm:ChannelStartViewModel.Sources}" SelectedIndex="{Binding SourceIndex}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Start of the first clip: held at the first clip's start level from the timeline's start (drag the clip's start dot to set it). Fixed level: the track's own level, held from the start even without clips. Leave alone: not touched until the first clip, so the faders or an ambient timeline underneath show (for scares)." />
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Text="Level (%)" Classes="label" Margin="0,0,8,0" />
                              <NumericUpDown Grid.Column="1" Value="{Binding Percent}" Minimum="0" Maximum="100" Increment="5" FormatString="0.#"
                                             ToolTip.Tip="The starting level" />
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <!-- An envelope handle -->
          <ContentControl Content="{Binding PointProperties}" IsVisible="{Binding ChannelPicker, Converter={x:Static ObjectConverters.IsNull}}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:PointPropertiesViewModel">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Heading}" Classes="heading" />
                  <TextBlock Text="{Binding Channel}" Opacity="0.75" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ClipName, StringFormat='in {0}'}" Opacity="0.6" FontSize="12" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto" Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="Time (s)" Classes="label" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Column="1" Value="{Binding TimeSeconds}" Minimum="0" Increment="0.1" FormatString="0.00#" IsEnabled="{Binding CanEditTime}"
                                   ToolTip.Tip="On the timeline. A handle stays between its neighbours; an end handle stays at the clip's end." />
                    <TextBlock Grid.Row="2" Text="Level (%)" Classes="label" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Percent}" Minimum="0" Maximum="100" Increment="5" FormatString="0.#" />
                    <TextBlock Grid.Row="4" Text="DMX (0–255)" Classes="label" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Dmx}" Minimum="0" Maximum="255" Increment="5" FormatString="0" />
                    <TextBlock Grid.Row="6" Text="Curve" Classes="label" Margin="0,0,8,0" />
                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{x:Static vm:PointPropertiesViewModel.Curves}" SelectedItem="{Binding Curve}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="How the level gets here from the previous handle: Linear fades, Step holds then jumps, Spline curves smoothly" />
                  </Grid>
                  <Button Content="Delete handle" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <ContentControl Content="{Binding Properties}" IsVisible="{Binding ChannelPicker, Converter={x:Static ObjectConverters.IsNull}}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:EventPropertiesViewModel">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Kind}" Classes="heading" />
                  <TextBlock Text="Name" Classes="label" />
                  <TextBox Text="{Binding Name}" PlaceholderText="(automatic)" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,4,0,0" IsEnabled="{Binding IsUnlocked}">
                    <TextBlock Text="Starts at (s)" Classes="label" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Column="1" Value="{Binding StartSeconds}" Minimum="0" Increment="0.1" FormatString="0.00#" />
                  </Grid>
                  <CheckBox Content="Enable playback" IsChecked="{Binding Enabled}" />
                  <CheckBox Content="Lock clip" IsChecked="{Binding Locked}"
                            ToolTip.Tip="A locked clip can't be moved, resized, split, deleted or edited" />

                  <!-- Level Control (lighting) clip -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsLightingClip}">
                    <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding IsUnlocked}">
                      <TextBlock Text="Length (s)" Classes="label" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Column="1" Value="{Binding ClipLengthSeconds}" Minimum="0.05" Increment="0.5" FormatString="0.00#"
                                     ToolTip.Tip="Changing the length scales or crops the envelopes (as dragging the clip's edge does)" />
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding IsLevelControl}">
                      <CheckBox Content="Scale envelopes on resize" IsChecked="{Binding ScaleOnResize}"
                                ToolTip.Tip="On: resizing the clip scales its envelopes with it. Off: resizing crops them (handles keep their times)." />
                      <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                 Text="Double-click the clip (or Envelopes…) to edit its envelopes in the Envelope Editor. Expand the track (▸) to see them on the timeline, where you can also drag handles or right-click the clip → Add Envelope Handle. Each envelope starts where the previous clip left the channel." />
                    </StackPanel>

                    <!-- Built-in effect -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsEffect}">
                      <StackPanel Spacing="6" IsEnabled="{Binding IsUnlocked}">
                        <ComboBox ItemsSource="{x:Static vm:EventPropertiesViewModel.EffectKinds}" SelectedItem="{Binding SelectedEffect}" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Which effect it is">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="tl:EffectInfo">
                              <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding EffectDescription}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,6,Auto">
                          <TextBlock Text="{Binding StrengthLabel}" Classes="label" Margin="0,0,8,0" />
                          <NumericUpDown Grid.Column="1" Value="{Binding StrengthPercent}" Minimum="0" Maximum="100" Increment="5" FormatString="0" />
                          <TextBlock Grid.Row="2" Text="{Binding RateLabel}" Classes="label" Margin="0,0,8,0" IsVisible="{Binding HasRate}" />
                          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Rate}" Minimum="{Binding RateMinimum}" Maximum="{Binding RateMaximum}"
                                         Increment="1" FormatString="0.##" IsVisible="{Binding HasRate}" />
                        </Grid>
                        <StackPanel Spacing="4" IsVisible="{Binding HasColor}">
                          <TextBlock Text="Colour" Classes="label" />
                          <DockPanel>
                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="3" BorderBrush="#80FFFFFF" BorderThickness="1" Margin="0,0,6,0"
                                    Background="{Binding EffectColor}" />
                            <TextBox Text="{Binding EffectColor}" ToolTip.Tip="As #RRGGBB" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{x:Static vm:EventPropertiesViewModel.Swatches}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Button Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,4,4" CornerRadius="3"
                                        Background="{Binding}" BorderBrush="#80FFFFFF" BorderThickness="1" ToolTip.Tip="{Binding}"
                                        Command="{Binding $parent[ItemsControl].((vm:EventPropertiesViewModel)DataContext).PickColorCommand}"
                                        CommandParameter="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <CheckBox Content="Leave the lights out at the end" IsChecked="{Binding EndsDark}"
                                  ToolTip.Tip="Off: when it ends, the lights go back where they were before it" />
                        <WrapPanel>
                          <Button Content="New random pattern" Command="{Binding NewPatternCommand}" Margin="0,0,6,6"
                                  ToolTip.Tip="Same settings, different timing (other strikes, another flicker)" />
                          <Button Content="Convert to Level Control" Command="{Binding ConvertToLevelControlCommand}" Margin="0,0,6,6"
                                  ToolTip.Tip="Turn the effect into envelope handles you can edit one by one" />
                        </WrapPanel>
                      </StackPanel>
                      <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                                 Text="An effect works on every channel of the track: dimmers flash or dim, colour channels take its colour (a fixture without a dimmer on the track dims through its colours), anything else (pan, gobo, …) is left alone. It starts from where the previous clip left the lights." />
                    </StackPanel>
                  </StackPanel>

                  <!-- Event track: run or stop a timeline -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsCommand}" IsEnabled="{Binding IsUnlocked}">
                    <ComboBox ItemsSource="{x:Static vm:EventPropertiesViewModel.Commands}" SelectedIndex="{Binding CommandIndex}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Timeline" Classes="label" />
                    <ComboBox ItemsSource="{Binding Timelines}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" PlaceholderText="(choose a timeline)" />
                    <CheckBox Content="Play once only" IsChecked="{Binding PlayOnceOnly}" IsVisible="{Binding IsRun}"
                              ToolTip.Tip="Off: each time the playhead gets here another copy plays, even while one is still playing. On: nothing while it's still playing." />
                    <TextBlock Text="Symbol" Classes="label" />
                    <ComboBox ItemsSource="{x:Static vm:EventPropertiesViewModel.Symbols}" SelectedItem="{Binding Symbol}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="How it's marked on the lane (green: run, red: stop)">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="tl:EventSymbol">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:EventSymbolIcon Symbol="{Binding}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="When this timeline's playhead gets here, it runs (from its start) or stops the other timeline, as VenueMagic's Run Timeline event does. A room's play timeline can start its lights and sounds this way." />
                  </StackPanel>

                  <!-- Audio -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsAudio}">
                    <TextBlock Text="File" Classes="label" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseFileCommand}" Margin="6,0,0,0" />
                      <TextBlock Text="{Binding File}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding File}" />
                    </DockPanel>
                    <TextBlock Text="{Binding FileLengthLabel}" Opacity="0.7" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto">
                      <TextBlock Text="Start in file (s)" Classes="label" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Column="1" Value="{Binding OffsetSeconds}" Minimum="0" Increment="0.1" FormatString="0.00#" />
                      <TextBlock Grid.Row="2" Text="Volume (%)" Classes="label" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding VolumePercent}" Minimum="0" Maximum="100" Increment="5" FormatString="0" />
                      <TextBlock Grid.Row="4" Text="Fade in (s)" Classes="label" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding FadeInSeconds}" Minimum="0" Increment="0.1" FormatString="0.00#" />
                      <TextBlock Grid.Row="6" Text="Fade out (s)" Classes="label" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding FadeOutSeconds}" Minimum="0" Increment="0.1" FormatString="0.00#" />
                    </Grid>
                    <CheckBox Content="Loop the file" IsChecked="{Binding AudioLoop}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <CheckBox Content="Play for (s)" IsChecked="{Binding HasLength}"
                                ToolTip.Tip="Unchecked: play to the end of the file (or forever, when looping)" />
                      <NumericUpDown Value="{Binding LengthSeconds}" Minimum="0.01" Increment="0.5" FormatString="0.00#" Width="120"
                                     IsEnabled="{Binding HasLength}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>
      </ScrollViewer>
    </Border>

    <!-- Track headers and lanes scroll up and down together; only the lanes scroll sideways. -->
    <Panel>
    <TextBlock Text="No timeline open. Double-click one in the list on the left, or make one with + Timeline."
               Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
               IsVisible="{Binding SelectedTimeline, Converter={x:Static ObjectConverters.IsNull}}" />
    <Border Classes="card" Padding="0" IsVisible="{Binding SelectedTimeline, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="180,*">
          <ListBox x:Name="TrackHeaders" Classes="tracks" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                   Margin="0,26,0,0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TrackRowViewModel">
                <!-- Same height as the canvas row (TimelineEditorViewModel.HeightOf). -->
                <DockPanel Height="{Binding Height}" Background="Transparent" ClipToBounds="True">
                  <DockPanel.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Channels…" Command="{Binding EditChannelsCommand}" IsVisible="{Binding IsLighting}" />
                      <MenuItem Header="{Binding ExpandGlyph, StringFormat='{}{0} Expand / collapse'}" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding IsLighting}" />
                      <MenuItem Header="Properties…" Command="{Binding EditPropertiesCommand}" />
                      <MenuItem Header="Test output" Command="{Binding TestOutputCommand}" IsVisible="{Binding IsAudio}"
                                ToolTip.Tip="Play a short tone on this track's output device" />
                      <Separator />
                      <MenuItem Header="Rename" InputGesture="F2" Command="{Binding StartRenameCommand}" />
                      <MenuItem Header="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" />
                      <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                      <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" ToolTip.Tip="Lower tracks win ties" />
                      <Separator />
                      <MenuItem Header="Remove track" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                  </DockPanel.ContextMenu>
                  <DockPanel DockPanel.Dock="Top" Height="{x:Static vm:TimelineEditorViewModel.CollapsedTrackHeight}">
                    <Button DockPanel.Dock="Left" Content="{Binding ExpandGlyph}" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding IsLighting}"
                            Padding="3,0" MinHeight="0" MinWidth="0" Background="Transparent" VerticalAlignment="Center"
                            ToolTip.Tip="Expand: show each clip's envelopes (to edit them)" />
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" ToolTip.Tip="Unchecked: the track is muted (not played)" MinWidth="0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="⚙" Command="{Binding EditChannelsCommand}" IsVisible="{Binding IsLighting}" VerticalAlignment="Center"
                            Padding="4,0" MinHeight="0" MinWidth="0" Background="Transparent" ToolTip.Tip="Channels this track controls…" />
                    <Button DockPanel.Dock="Right" Content="⚙" Command="{Binding EditPropertiesCommand}" IsVisible="{Binding IsAudio}" VerticalAlignment="Center"
                            Padding="4,0" MinHeight="0" MinWidth="0" Background="Transparent" ToolTip.Tip="{Binding OutputTip, StringFormat='Track properties… ({0})'}" />
                    <!-- The name: double-click or F2 to rename (a plain text box here was too easy to edit by accident). -->
                    <Panel VerticalAlignment="Center">
                      <TextBlock Classes="trackName" Text="{Binding Name}" Padding="4,2" FontSize="12" IsVisible="{Binding !IsRenaming}"
                                 TextTrimming="CharacterEllipsis" Background="Transparent" />
                      <TextBox Classes="trackRename" Text="{Binding EditName}" Padding="4,1" MinHeight="0" FontSize="12" IsVisible="{Binding IsRenaming}" />
                    </Panel>
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding Subtitle}" FontSize="10" Opacity="0.6" Margin="22,-6,0,2"
                             IsVisible="{Binding ShowSubtitle}" TextTrimming="CharacterEllipsis" />
                  <!-- Audio: the track's volume (multiplied into every clip's own) -->
                  <DockPanel DockPanel.Dock="Top" IsVisible="{Binding IsAudio}" Margin="8,-9,6,0" Height="32"
                             ToolTip.Tip="Track volume: every clip on this track plays at this much of its own volume">
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Volume}" Width="12" Height="12" Opacity="0.75" Margin="0,0,6,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeLabel}" FontSize="10" Opacity="0.8" Width="30"
                               TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider Value="{Binding VolumePercent}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center" />
                  </DockPanel>
                  <!-- Expanded: which colour is which channel -->
                  <ItemsControl ItemsSource="{Binding Lanes}" IsVisible="{Binding IsExpanded}" Margin="22,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LaneRowViewModel">
                        <DockPanel Height="16">
                          <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{Binding Color}" Margin="0,0,5,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.85" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer Grid.Column="1" x:Name="LanesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Panel>
              <controls:TimelineCanvas x:Name="Canvas" Editor="{Binding}" />
              <controls:Playhead x:Name="PlayheadLine" Position="{Binding Playback.Position}" PixelsPerSecond="{Binding PixelsPerSecond}" />
            </Panel>
          </ScrollViewer>
        </Grid>
      </ScrollViewer>
    </Border>
    </Panel>
  </DockPanel>
  </Grid>
</UserControl>
