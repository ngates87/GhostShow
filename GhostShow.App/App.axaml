<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GhostShow.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fault">
      <Setter Property="Foreground" Value="OrangeRed" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="Goldenrod" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.cell.changed">
      <Setter Property="BorderBrush" Value="Gold" />
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Width" Value="190" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile.current">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </Application.Styles>
</Application>
