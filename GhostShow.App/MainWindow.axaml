<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GhostShow.App.ViewModels"
        xmlns:views="using:GhostShow.App.Views"
        xmlns:controls="using:GhostShow.App.Controls"
        x:Class="GhostShow.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title, FallbackValue=GhostShow}"
        Icon="avares://ghostshow-app/Assets/ghostshow.ico"
        Width="1200" Height="780" MinWidth="800" MinHeight="500">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseShowCommand}" />
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding ExitCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding BlackoutCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Timeline}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Fixtures}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Audio}" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Diagnostics}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- Menu bar, with what needs attention and Blackout at its right (on every screen; Blackout even with no show
         open). The transport and time are under the timeline. -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,2" VerticalAlignment="Center">
        <!-- Problems worth knowing about (patch errors, failing outputs); only there when there are some. -->
        <Button Padding="10,3" Background="#5A3A00" IsVisible="{Binding !!Warnings.Count}"
                ToolTip.Tip="Things that need attention">
          <TextBlock><Run Text="⚠ " /><Run Text="{Binding Warnings.Count}" /></TextBlock>
          <Button.Flyout>
            <Flyout>
              <ItemsControl ItemsSource="{Binding Warnings}" MaxWidth="420">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Content="Blackout" Command="{Binding BlackoutCommand}"
                ToolTip.Tip="Stop playback and set every channel of every universe to 0 (Ctrl+B)"
                Background="DarkRed" Foreground="White" FontWeight="SemiBold" Padding="16,3" />
      </StackPanel>
      <!-- Shortcut keys shown in the menus are handled by the window (file, view) or the timeline screen (editing,
           Space for play/pause), so they work whether or not the menu is open. -->
      <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_New Show" InputGesture="Ctrl+N" Command="{Binding NewCommand}" />
        <MenuItem Header="_Open Show…" InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <MenuItem Header="_Import VenueMagic Project…" Command="{Binding ImportVenueMagicCommand}" />
        <MenuItem Header="Open _Recent" Classes="recentRoot" ItemsSource="{Binding RecentShows}" IsEnabled="{Binding !!RecentShows.Count}">
          <MenuItem.Styles>
            <Style Selector="MenuItem:not(.recentRoot)" x:DataType="vm:RecentShowRow">
              <Setter Property="Header" Value="{Binding Path}" />
              <Setter Property="IsEnabled" Value="{Binding Exists}" />
              <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="Open Older Show _File (.json)…" Command="{Binding OpenOldShowCommand}" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <Separator />
        <MenuItem Header="_Close Show" InputGesture="Ctrl+W" Command="{Binding CloseShowCommand}" />
        <Separator />
        <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding Timeline.UndoLabel}" InputGesture="Ctrl+Z" Command="{Binding Timeline.UndoCommand}" />
        <MenuItem Header="{Binding Timeline.RedoLabel}" InputGesture="Ctrl+Y" Command="{Binding Timeline.RedoCommand}" />
        <Separator />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding Timeline.CopyCommand}" />
        <MenuItem Header="_Paste at Playhead" InputGesture="Ctrl+V" Command="{Binding Timeline.PasteCommand}" />
        <MenuItem Header="_Duplicate" InputGesture="Ctrl+D" Command="{Binding Timeline.DuplicateCommand}" />
        <MenuItem Header="De_lete" InputGesture="Delete" Command="{Binding Timeline.DeleteCommand}" />
        <Separator />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Command="{Binding Timeline.SelectAllCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Timeline" InputGesture="Ctrl+1" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Timeline}" />
        <MenuItem Header="_Lighting">
          <MenuItem Header="_DMX Setup" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.DmxSetup}" />
          <MenuItem Header="_Fixtures" InputGesture="Ctrl+2" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Fixtures}" />
          <MenuItem Header="_Control" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Control}" />
          <MenuItem Header="C_hannels" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Channels}" />
          <MenuItem Header="_Monitor" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Monitor}" />
        </MenuItem>
        <MenuItem Header="_Audio" InputGesture="Ctrl+3" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Audio}" />
        <MenuItem Header="D_iagnostics" InputGesture="Ctrl+4" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Diagnostics}" />
        <Separator />
        <MenuItem Header="Zoom _In" Command="{Binding Timeline.ZoomInCommand}" />
        <MenuItem Header="Zoom _Out" Command="{Binding Timeline.ZoomOutCommand}" />
      </MenuItem>
      <MenuItem Header="_Playback">
        <MenuItem Header="{Binding Playback.PlayPauseLabel}" InputGesture="Space" Command="{Binding Playback.PlayPauseCommand}" />
        <MenuItem Header="_Stop" Command="{Binding Playback.StopCommand}" />
        <MenuItem Header="Play from _Start" Command="{Binding Playback.RestartCommand}" />
        <MenuItem Header="Stop _All Timelines" Command="{Binding Playback.StopAllCommand}" />
        <Separator />
        <MenuItem Header="_Blackout" InputGesture="Ctrl+B" Command="{Binding BlackoutCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About GhostShow" Click="OnAbout" />
      </MenuItem>
    </Menu>
    </DockPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <!-- Load meter: the worst of CPU, playback timing and UI response; click for Diagnostics (with a show open) -->
        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="4,1" MinHeight="0" Background="Transparent" BorderThickness="0"
                Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:Page.Diagnostics}"
                ToolTip.Tip="{Binding Performance.Tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="LOAD" FontSize="10" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
            <controls:LoadMeter Value="{Binding Performance.Level}" Width="120" Height="14" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Library.Summary}" Opacity="0.7" />
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- With a show open: Timeline, Lighting (its own row of screens), Audio, Diagnostics. The tab strips only choose
         the page; every screen below stays built and is just shown or hidden, so switching is instant (rebuilding a
         screen such as the 512-channel monitor on every visit took hundreds of milliseconds). -->
    <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0" IsVisible="{Binding IsShowOpen}">
      <TabStrip Classes="sections" SelectedIndex="{Binding SelectedSection}">
        <TabStripItem Content="Timeline" />
        <TabStripItem Content="Lighting" />
        <TabStripItem Content="Audio" />
        <TabStripItem Content="Diagnostics" />
      </TabStrip>
      <TabStrip Classes="pages" SelectedIndex="{Binding SelectedLightingPage}"
                IsVisible="{Binding SelectedSection, Converter={x:Static vm:Converters.SectionIs}, ConverterParameter={x:Static vm:Section.Lighting}}">
        <TabStripItem Content="DMX setup" />
        <TabStripItem Content="Fixtures" />
        <TabStripItem Content="Control" />
        <TabStripItem Content="Channels" />
        <TabStripItem Content="Monitor" />
      </TabStrip>
    </StackPanel>

    <!-- Getting started: on the Timeline screen while the show isn't set up yet -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="8,6,8,0" Padding="12,8" IsVisible="{Binding Guide.IsVisible}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" Command="{Binding Guide.DismissCommand}" VerticalAlignment="Top" Padding="8,2"
                Background="Transparent" ToolTip.Tip="Hide (for this show)" />
        <TextBlock DockPanel.Dock="Top" Text="Getting started" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Guide.Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SetupStepViewModel">
              <DockPanel Margin="0,0,24,4" MaxWidth="380">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"
                           Foreground="{Binding IsDone, Converter={x:Static vm:Converters.DoneBrush}}" />
                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding GoCommand}" IsVisible="{Binding !IsDone}"
                        VerticalAlignment="Center" Margin="8,0,0,0" Padding="10,3" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Opacity="{Binding IsDone, Converter={x:Static vm:Converters.DoneOpacity}}" />
                  <TextBlock Text="{Binding Hint}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" IsVisible="{Binding !IsDone}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Panel Margin="8,0,8,0">
      <views:HomeView IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Home}}" />
      <!-- The timeline, with the show's buttons beside it -->
      <DockPanel IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Timeline}}">
        <views:ButtonsPanel DockPanel.Dock="Right" DataContext="{Binding Buttons}" />
        <views:TimelineView DataContext="{Binding Timeline}" />
      </DockPanel>
      <views:DiagnosticsView DataContext="{Binding Diagnostics}"
                             IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Diagnostics}}" />
      <views:OutputsView DataContext="{Binding Outputs}"
                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.DmxSetup}}" />
      <views:FixtureSetupView DataContext="{Binding Fixtures}"
                              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Fixtures}}" />
      <views:FixtureControlView DataContext="{Binding Control}"
                                IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Control}}" />
      <views:ChannelsView IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Channels}}" />
      <views:MonitorView IsVisible="{Binding CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Monitor}}" />
      <views:AudioView DataContext="{Binding Audio}"
                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).CurrentPage, Converter={x:Static vm:Converters.PageIs}, ConverterParameter={x:Static vm:Page.Audio}}" />
    </Panel>
  </DockPanel>
</Window>
